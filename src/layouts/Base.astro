---
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** 'article'이면 BlogPosting JSON-LD와 article 메타를 추가 */
  type?: 'website' | 'article';
  image?: string;
  published?: Date;
  updated?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  image = '/images/og_image.png',
  published,
  updated,
  tags = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage.toString(),
        datePublished: published?.toISOString(),
        dateModified: (updated ?? published)?.toISOString(),
        keywords: tags.join(', '),
        inLanguage: 'ko',
        author: { '@type': 'Person', name: SITE.author, url: SITE.github },
        mainEntityOfPage: canonical.toString(),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Blog',
        name: SITE.title,
        description: SITE.description,
        url: Astro.site?.toString(),
        inLanguage: 'ko',
        author: { '@type': 'Person', name: SITE.author, url: SITE.github },
      };
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14181b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // 첫 그리기 전에 테마를 적용해 깜빡임을 막는다
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href="/">{SITE.brand}</a>
        <nav class="site-nav" aria-label="주요 메뉴">
          <a href="/" aria-current={isActive('/') ? 'page' : undefined}>글</a>
          <a href="/tags/" aria-current={isActive('/tags/') ? 'page' : undefined}>태그</a>
          <a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined}>소개</a>
          <a href="/search/" aria-current={isActive('/search/') ? 'page' : undefined}>검색</a>
          <button class="theme-toggle" type="button" id="theme-toggle" aria-label="테마 전환">◐</button>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span>
          <a href="/rss.xml">RSS</a> · <a href="/llms.txt">llms.txt</a> · <a href={SITE.github} rel="me">GitHub</a>
        </span>
      </footer>
    </div>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const currentDark = root.dataset.theme ? root.dataset.theme === 'dark' : systemDark;
        const next = currentDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
